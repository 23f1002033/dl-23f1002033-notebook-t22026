    "def map3(logits, labels):\n",
    "    order = np.argsort(-logits, axis=1)\n",
    "    s = 0.0\n",
    "    for o, l in zip(order, labels):\n",
    "        pos = int(np.where(o == l)[0][0])\n",
    "        if pos < 3:\n",
    "            s += 1.0 / (pos + 1)\n",
    "    return s / len(labels)\n",
    "\n",
    "def compute_metrics(p):\n",
    "    logits, labels = p\n",
    "    return {\"map@3\": map3(logits, labels),\n",
    "            \"acc\": float((logits.argmax(1) == labels).mean())}"
   ]
  },
